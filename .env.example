# ==============================================================================
# Hirable Project Environment Variables Template (.env.example)
# Copy this file to '.env' and populate with real configuration settings.
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Vite React Client)
# ------------------------------------------------------------------------------
# Central API URL for the Node/Express backend.
# Local development fallback: http://localhost:5000
VITE_API_URL=

# Firebase Client Configuration (Web SDK Config)
# Note: These are non-secret client parameters required by Firebase initialized in browser.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ------------------------------------------------------------------------------
# BACKEND CONFIGURATION (Node.js Express Server)
# ------------------------------------------------------------------------------
# Port for the Express server to listen on.
# Default fallback: 5000
PORT=

# Allowed CORS Frontend URL (Use comma-separated list if multiple URLs are needed)
# Local development fallback: http://localhost:5173
FRONTEND_URL=

# FastAPI NLP/AI Service URL for service-to-service communication
# Local development fallback: http://127.0.0.1:8000
AI_SERVICE_URL=
